{
  "name": "aws-prueba-infrastructure",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "AWS CDK infrastructure for the aws-prueba project",
  "scripts": {
    "build": "tsc --noEmit",
    "migrate:dev": "ts-node scripts/migrate-dev.ts",
    "synth": "cdk synth --context environment=dev",
    "synth:network": "cdk synth NetworkStack --context environment=dev",
    "diff:network": "cdk diff NetworkStack --context environment=dev",
    "deploy:network": "cdk deploy NetworkStack --context environment=dev",
    "destroy:network": "cdk destroy NetworkStack --context environment=dev",
    "synth:data": "cdk synth DataStack --context environment=dev",
    "diff:data": "cdk diff DataStack --context environment=dev",
    "deploy:data": "cdk deploy DataStack --context environment=dev",
    "destroy:data": "cdk destroy DataStack --context environment=dev",
    "synth:serverless": "cdk synth ServerlessStack --context environment=dev",
    "diff:serverless": "cdk diff ServerlessStack --context environment=dev",
    "deploy:serverless": "cdk deploy ServerlessStack --context environment=dev",
    "destroy:serverless": "cdk destroy ServerlessStack --context environment=dev",
    "synth:compute": "cdk synth ComputeStack --context environment=dev",
    "diff:compute": "cdk diff ComputeStack --context environment=dev",
    "deploy:compute": "cdk deploy ComputeStack --context environment=dev",
    "destroy:compute": "cdk destroy ComputeStack --context environment=dev"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "aws-cdk": "2.1137.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
